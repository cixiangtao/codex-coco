{
  "name": "codex-coco",
  "version": "0.1.0-dev.1",
  "private": true,
  "description": "一个按自己习惯打磨的 Codex 桌面伴侣。",
  "license": "MIT",
  "author": "cixiangtao",
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "pnpm --filter @codex-coco/desktop dev",
    "build": "pnpm --filter @codex-coco/desktop build",
    "start": "pnpm --filter @codex-coco/desktop start",
    "pack": "pnpm --filter @codex-coco/desktop run pack",
    "lint": "oxlint --deny-warnings . && node scripts/check-boundaries.mjs",
    "lint:fix": "oxlint --fix .",
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p tsconfig.tools.json",
    "test": "vitest run",
    "profile:desktop": "pnpm run build && node scripts/profile-desktop.mjs",
    "profile:packaged": "pnpm run pack && node scripts/profile-desktop.mjs --packaged",
    "verify:diagnostics": "pnpm run build && node scripts/verify-diagnostics.mjs",
    "verify:modules": "pnpm run build && node scripts/verify-modules.mjs",
    "verify:workers": "pnpm run build && node scripts/verify-workers.mjs",
    "verify:usage": "pnpm run build && node scripts/verify-usage.mjs",
    "verify:desktop": "pnpm run build && node scripts/verify-desktop.mjs",
    "verify:packaged": "pnpm run pack && node scripts/verify-desktop.mjs --packaged && node scripts/verify-menu-bar.mjs --packaged && node scripts/verify-workers.mjs --packaged && node scripts/verify-usage.mjs --packaged && node scripts/verify-appearance.mjs --packaged && node scripts/verify-usage-policy.mjs --packaged && node scripts/verify-local-usage.mjs --packaged && node scripts/verify-usage-reset.mjs --packaged && node scripts/verify-usage-tools.mjs --packaged && node scripts/verify-desktop-preferences.mjs --packaged && node scripts/verify-updates.mjs --packaged",
    "verify:menu-bar": "pnpm run build && node scripts/verify-menu-bar.mjs",
    "design:review": "pnpm --filter @codex-coco/desktop run design:review",
    "design:build": "pnpm --filter @codex-coco/desktop run design:build",
    "verify:appearance": "pnpm run build && node scripts/verify-appearance.mjs",
    "verify:usage-policy": "pnpm run build && node scripts/verify-usage-policy.mjs",
    "verify:local-usage": "pnpm run build && node scripts/verify-local-usage.mjs",
    "verify:usage-reset": "pnpm run build && node scripts/verify-usage-reset.mjs",
    "verify:usage-tools": "pnpm run build && node scripts/verify-usage-tools.mjs",
    "verify:desktop-preferences": "pnpm run build && node scripts/verify-desktop-preferences.mjs",
    "verify:widget": "node scripts/verify-widget.mjs",
    "verify:updates": "pnpm run build && node scripts/verify-updates.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxc-parser": "0.155.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.14.0",
  "productName": "Codex Coco"
}
